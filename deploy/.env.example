# Copy to .env in the repository root and fill in.

# Public host name that points at this server (e.g. a free DuckDNS name).
DOMAIN=yourteam.duckdns.org

# Data created on the very first start only: "demo" or "empty".
SEED=empty

# Optional: comma-separated IPs or IPv4 ranges that are never rate limited or blocked,
# e.g. your office's shared public address. Leave empty unless you need it.
SECURITY_ALLOWLIST=
