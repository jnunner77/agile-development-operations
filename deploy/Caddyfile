{
	servers {
		# Drop connections that send headers or bodies too slowly (slowloris) or sit idle.
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
		max_header_size 16KB
	}
}

# Protections every site on this server gets.
(protect) {
	# Nothing the apps accept is bigger than a backup import (50 MB).
	request_body {
		max_size 60MB
	}

	# Only the methods the apps use.
	@badMethod not method GET HEAD POST PUT PATCH DELETE
	respond @badMethod 405

	# Automated scanners looking for other software: close the connection without answering.
	@scanners {
		path /.env* /.git* /.svn* /.hg* /.aws* /.ssh* /.docker* /.DS_Store
		path /wp-* /wordpress* /xmlrpc.php /phpmyadmin* /pma* /adminer* /cgi-bin/*
		path /actuator* /server-status* /solr* /jenkins* /manager/html* /owa/* /autodiscover*
		path *.php *.asp *.aspx *.jsp *.cgi *.sql *.bak *.old *.swp *.ini *.log
	}
	abort @scanners

	# Compress everything except live-update streams, which must reach browsers unbuffered.
	@compressible not path /api/events
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
		-Via
	}
}

{$DOMAIN} {
	import protect
	reverse_proxy app:4000
}

# The Pokémon Binder Ledger (github.com/jnunner77/pokemon-card-organizer), run with its
# deploy/with-boards.yml so this server's Docker network reaches it as binder:4100. Until it
# runs, this address answers 502; Boards is unaffected. See "Hosting more apps" in deploy/README.md.
binder.{$DOMAIN} {
	import protect
	reverse_proxy binder:4100
}
