{
  "name": "agile-development-operations",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted Azure DevOps-style backlog, board and sprint management tool.",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#presentation/*": "./src/presentation/*"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/main.ts",
    "typecheck": "tsc -b && tsc -p client && tsc -p tests/legacy",
    "test": "node --test \"tests/{shared,domain,application,infrastructure,presentation}/**/*.test.ts\" && vitest run",
    "test:unit": "node --test \"tests/{shared,domain,application,infrastructure,presentation}/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:mobile": "node e2e/mobile.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
